# content-os reads credentials only from environment variables. Copy the names
# into your agent's secret store (Hermes: ~/.hermes/.env, or let Hermes prompt
# when a skill loads). Never commit real values; .env is git-ignored.

# YouTube Data API v3 key: news-intel, ai-trend-scan, outlier-radar, morning-intel,
# yt-pipeline, deep-research-chase, content-cascade (metadata).
YOUTUBE_API_KEY=
# twitterapi.io key (optional; without it X falls back to web search):
# news-intel, ai-trend-scan, morning-intel, deep-research-chase.
TWITTERAPI_IO_KEY=
# GitHub token without scopes (optional; raises the rate limit): github-trending.
GITHUB_TOKEN=

# --- Non-secret settings (optional) ---
# Data root for reports, in the agentic-os layout (default ~/content-os-vault).
CONTENT_OS_VAULT=
# X budget ledger and run files (default ~/.content-os/state).
CONTENT_OS_STATE_DIR=
# IANA time zone for report dates (default: the computer's zone), e.g. Asia/Shanghai.
CONTENT_OS_TZ=
# X posts per UTC day across all runs (default 600, ceiling 5000).
X_DATA_DAILY_POST_LIMIT=
# Python used for github-trending (default python3).
CONTENT_OS_PYTHON=
